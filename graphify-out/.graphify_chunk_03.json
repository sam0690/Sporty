    {"id": "e6f7a8b9c0d1_dedupe_players_upgrade", "label": "Migration: dedupe duplicate player rows across namespaces", "file_type": "code", "source_file": "Sporty_Backend/alembic/versions/e6f7a8b9c0d1_dedupe_players.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Different importers (roster sync using 'nba:'/'football:' namespaces vs. the data feeder using 'feeder:player:') created duplicate player rows for the same real player because dedup only keyed on external_api_id, not name+team identity; canonical rows are chosen by preferring non-feeder rows, most gameweek stats, higher cost, then lowest id. Deliberately does not add a uniqueness constraint yet because importers must first learn to match by name+team fallback."},
    {"id": "f7a8b9c0d1e2_draft_roster_phase1_upgrade", "label": "Migration: draft roster mgmt phase 1 (team_players league_id/is_draft, roster_moves)", "file_type": "code", "source_file": "Sporty_Backend/alembic/versions/f7a8b9c0d1e2_draft_roster_phase1.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Denormalises league_id and snapshots is_draft onto team_players so the free-agent pool query and ownership index avoid a fantasy_teams/leagues join; enforces league-wide unique active ownership only for draft leagues since budget/classic leagues intentionally allow shared ownership."},
    {"id": "a8b9c0d1e2f3_draft_roster_phase2_upgrade", "label": "Migration: draft roster mgmt phase 2 (waiver_order, waiver_claims, trade_offers)", "file_type": "code", "source_file": "Sporty_Backend/alembic/versions/a8b9c0d1e2f3_draft_roster_phase2.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
