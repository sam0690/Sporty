# Sporty Backend Environment Configuration
# ==========================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env files to version control.

# ============================================
# ENVIRONMENT
# ============================================
# Options: development, staging, production
ENVIRONMENT=development

# ============================================
# ERROR TRACKING (Sentry)
# ============================================
# Leave empty to disable (local dev default). Get a DSN from sentry.io.
SENTRY_DSN=

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/sporty_db

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379/0
# Celery broker + result backend. With a plain local Redis you can use
# separate DB indices (/1, /2) as shown below. Managed single-DB providers
# (e.g. Upstash) don't support SELECT to other DB indices — in that case set
# both of these to the exact same URL as REDIS_URL instead. If that URL uses
# rediss:// (TLS), Celery's redis transport additionally requires an explicit
# ?ssl_cert_reqs=CERT_REQUIRED query param (REDIS_URL itself doesn't need this
# — only Celery's stricter redis backend enforces it).
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# JWT & SECURITY
# ============================================
# MUST be at least 32 characters. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# GOOGLE OAUTH
# ============================================
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# CORS (comma-separated list of origins)
# ============================================
# Production: Set to your actual frontend domain(s)
CORS_PRODUCTION_ORIGINS=https://sporty.com,https://www.sporty.com
CORS_STAGING_ORIGINS=https://staging.sporty.com
CORS_LOCAL_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ============================================
# COOKIE SECURITY
# ============================================
# Production: COOKIE_SECURE=True + COOKIE_SAME_SITE=none (required for cross-origin SPA)
# Development: COOKIE_SECURE=False + COOKIE_SAME_SITE=lax (use Next.js rewrites for POST)
# WARNING: SameSite=None without Secure=True is rejected by modern browsers.
COOKIE_SECURE=False
COOKIE_SAME_SITE=lax
# Leave empty for current domain, or set to ".yourdomain.com" for subdomains
COOKIE_DOMAIN=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=True
# Requests per minute
RATE_LIMIT_GLOBAL_RPM=120
RATE_LIMIT_LOGIN_RPM=10
RATE_LIMIT_REGISTER_RPM=5
RATE_LIMIT_REFRESH_RPM=20
RATE_LIMIT_FORGOT_PASSWORD_RPM=3
RATE_LIMIT_RESET_PASSWORD_RPM=5
# Window size in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# CSRF PROTECTION
# ============================================
CSRF_ENABLED=True
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
# Comma-separated paths exempt from CSRF
CSRF_EXEMPT_PATHS=/health,/metrics,/docs,/redoc,/openapi.json

# ============================================
# EXTERNAL API KEYS
# ============================================

# RapidAPI Football API
# Get your key at: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_FOOTBALL_KEY=your-football-api-key

# RapidAPI NBA API
# Get your key at: https://rapidapi.com/api-sports/api/api-nba
RAPIDAPI_NBA_KEY=your-nba-api-key

# Cricket API
# Get your key at: https://www.cricapi.com/
CRICKET_API_KEY=your-cricket-api-key

# BallDontLie (Free NBA API)
# Get your key at: https://www.balldontlie.io/
BALLDONTLIE_API_KEY=your-balldontlie-key

# ============================================
# EMAIL / NOTIFICATIONS
# ============================================

# Resend (https://resend.com)
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL=no-reply@yourdomain.com

# Frontend URL (for password reset links)
FRONTEND_BASE_URL=http://localhost:3000

# ============================================
# CLOUDFLARE R2 (avatar/object storage)
# ============================================
# Leave blank to disable avatar uploads (returns 503).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Bucket's public r2.dev URL or a custom domain attached to the bucket
R2_PUBLIC_URL_BASE=

# ============================================
# PUSH NOTIFICATIONS (optional)
# ============================================
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json
APNS_USE_SANDBOX=True
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ============================================
# REALTIME PIPELINE (optional)
# ============================================
REALTIME_PIPELINE_ENABLED=False

# Real-API live-match polling (football + NBA). Off by default — live match
# data currently comes from the SportyDataFeeder simulator instead. See
# app/services/sync/football_live_sync.py / nba_live_sync.py.
LIVE_POLLING_ENABLED=False

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=sporty
INFLUXDB_BUCKET=sporty_realtime

# ============================================
# SPORTY DATA FEEDER
# ============================================
# Shared secret for inbound /api/v1/feed/* pushes from the Sporty Data Feeder.
# Must match FEEDER_SECRET in the feeder's .env. Empty disables feed endpoints.
FEEDER_SECRET=32_char_random_string
